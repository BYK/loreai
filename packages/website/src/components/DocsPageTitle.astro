---
import PageTitle from "@astrojs/starlight/components/PageTitle.astro";
import ReferenceFinder from "./ReferenceFinder.astro";
const path = Astro.url.pathname;
const page = path.split("/docs/")[1] ?? "";
const reference = ["configuration/","environment/"].includes(page);
const section = page.startsWith("guides/") ? "Guides" : ["","install/","first-session/","troubleshooting/"].includes(page) ? "Getting started" : ["configuration/","environment/","architecture/","installation-reference/","setup/","benchmark/"].includes(page) ? "Reference" : page === "review/" ? "Contributing" : "Using Lore";
---
<div class="docs-journal-title"><p class="field-marker">Lore / {section}</p><PageTitle {...Astro.props} /></div>
{reference && <ReferenceFinder />}
