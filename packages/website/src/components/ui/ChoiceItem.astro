---
interface Props { name: string; value: string; label: string; checked?: boolean; controls?: string; prefix?: string; class?: string; }
const { name,value,label,checked = false,controls,prefix,class: className } = Astro.props;
---
<label class:list={["ui-choice-item",className]}><input type="radio" name={name} value={value} checked={checked} aria-label={label} aria-controls={controls} /><span class="ui-choice-label">{prefix && <small aria-hidden="true">{prefix}</small>}{label}</span></label>
