---
// Adapts shadcn/ui's trigger/content composition to native Astro disclosures.
// See SHADCN-LICENSE.md. Native open state also works before JavaScript loads.
interface Props { title: string; meta?: string; class?: string; name?: string; id?: string; open?: boolean; }
const { title, meta, class: className, name, id, open } = Astro.props;
---
<details data-slot="accordion-item" class:list={["ui-accordion-item", className]} name={name} id={id} open={open}>
  <summary data-slot="accordion-trigger" class="ui-accordion-trigger">
    <span class="ui-accordion-label">{title}{meta && <> <span class="ui-accordion-meta">{meta}</span></>}</span>
    <svg data-slot="accordion-chevron" class="ui-accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <div data-slot="accordion-content" class="ui-accordion-content"><slot /></div>
</details>
<script>import "../../scripts/accordion";</script>
