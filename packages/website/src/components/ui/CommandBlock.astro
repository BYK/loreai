---
interface Props { command: string; kind: "install" | "connection"; copyLabel: string; hint?: string; }
const { command,kind,copyLabel,hint } = Astro.props;
---
<div class:list={["ui-command",{"install-box":kind === "install"}]}><div class:list={["ui-command-row",{"install-command":kind === "install"}]}><pre><code tabindex="0">{command}</code></pre><button type="button" class="button button-secondary" data-copy-install={kind === "install" ? "" : undefined} data-copy-setup={kind === "connection" ? "" : undefined} hidden aria-label={copyLabel}>Copy command</button></div><p class:list={["ui-command-status",kind === "install" ? "copy-status" : "setup-copy-status"]} role="status" aria-live="polite">{hint}</p></div>
<script>import "../../scripts/install-copy";</script>
