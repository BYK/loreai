---
const base=import.meta.env.BASE_URL;
import { TOUR_SCREENS as screens } from "../lib/product-tour";
import KnowledgeInspector from "./KnowledgeInspector.astro";
import JournalArt from "./JournalArt.astro";
---
<section class="section product-tour" id="product" aria-labelledby="tour-title">
 <div class="section-heading field-heading"><div><p class="eyebrow field-marker">Inside the local app · Sample data</p><h2 id="tour-title">Your project memory, with a way to inspect it.</h2><p>Lore’s memory browser runs locally with the gateway. These are captures of the actual app using a fictional webhook project.</p></div><JournalArt name="decision" size={80} /></div>
 <div class="tour-journal field-frame"><fieldset class="tour-picker"><legend class="visually-hidden">Explore the local app</legend>{screens.map((screen,index)=><label><input type="radio" name="product-tour" value={screen.id} checked={index===0} aria-label={screen.choice} aria-controls={`tour-${screen.id}`} /><span class="journal-step" aria-hidden="true">0{index+1}</span><span>{screen.choice}</span></label>)}</fieldset><div class="tour-pages">
 {screens.map(screen=><figure class="tour-panel" data-tour-panel={screen.id} id={`tour-${screen.id}`}>
  <div class="tour-caption"><h3>{screen.title}</h3><p>{screen.description}</p><a href={`${base}docs/${screen.link}`}>{screen.action} →</a></div>
  {screen.id === "knowledge" ? <KnowledgeInspector /> : <>
  {(["light","dark"] as const).map(theme=><a class:list={["tour-image-link",`tour-shot-${theme}`]} href={`${base}product-tour/${screen.id}-${theme}.png`} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size ${screen.choice.toLowerCase()} screenshot`}><picture><img src={`${base}product-tour/${screen.id}-${theme}.png`} width="1120" height="760" loading="lazy" decoding="async" alt={screen.alt} /></picture></a>)}
  </>}
  <figcaption class="small muted">{screen.id === "knowledge" ? "Sample data in the actual Lore app. Full-size captures remain available below." : "Sample data in the actual Lore app. Select the image to inspect it at full size."}
  {screen.id === "knowledge" && <p class="capture-links small">{(["light","dark"] as const).map(theme => <a class={`tour-shot-${theme}`} href={`${base}product-tour/knowledge-${theme}.png`} target="_blank" rel="noopener noreferrer" aria-label="Open full-size review knowledge screenshot">Open full-size app screenshot ↗</a>)}{(["light","dark"] as const).map(theme => <a class={`tour-shot-${theme}`} href={`${base}product-tour/knowledge-detail-${theme}.png`} target="_blank" rel="noopener noreferrer">Inspect source and revision details ↗</a>)}</p>}</figcaption>
 </figure>)}
 </div></div>
</section>

<script>
import { bindUrlChoice } from "../scripts/url-choice";
import { TOUR_SCREENS } from "../lib/product-tour";
bindUrlChoice(".tour-picker", "view", TOUR_SCREENS.map(screen => screen.id));
</script>
