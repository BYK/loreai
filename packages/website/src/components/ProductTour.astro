---
const base=import.meta.env.BASE_URL;
const screens=[
 {id:"sessions",choice:"Find a session",title:"See what Lore recorded",description:"Open your project’s Sessions list to find a recorded conversation. A session appearing here is your first connection check.",link:"first-session/#verify",action:"Verify your first session",alt:"Actual Lore app with a sample webhook-service project and three recorded sessions"},
 {id:"knowledge",choice:"Review knowledge",title:"Read the rule and where it came from",description:"Open a knowledge entry, inspect Source & history, and edit inaccurate information. Review the resulting .lore.md diff before sharing it through Git.",link:"using-lore/#review-knowledge",action:"Learn to review knowledge",alt:"Actual Lore app showing a sample webhook decision, its content, and source history"},
 {id:"usage",choice:"Inspect activity",title:"Understand your model activity",description:"Model usage counts recorded session-days by model. For estimated spending and background work, use Providers & costs in the app; activity counts are not a bill.",link:"data-and-costs/#inspect-usage",action:"Understand usage and costs",alt:"Actual Lore Model usage screen with synthetic session-day counts across two models"},
];
---
<section class="section product-tour" id="product" aria-labelledby="tour-title">
 <div class="section-heading"><p class="eyebrow">Inside the local app · Sample data</p><h2 id="tour-title">Your project memory, with a way to inspect it.</h2><p>Lore’s memory browser runs locally with the gateway. These are captures of the actual app using a fictional webhook project.</p></div>
 <fieldset class="tour-picker"><legend class="visually-hidden">Explore the local app</legend>{screens.map((screen,index)=><label><input type="radio" name="product-tour" value={screen.id} checked={index===0} aria-label={screen.choice} aria-controls={`tour-${screen.id}`} /><span>{screen.choice}</span></label>)}</fieldset>
 {screens.map(screen=><figure class="tour-panel" data-tour-panel={screen.id} id={`tour-${screen.id}`}>
  <div class="tour-caption"><h3>{screen.title}</h3><p>{screen.description}</p><a href={`${base}docs/${screen.link}`}>{screen.action} →</a></div>
  {(["light","dark"] as const).map(theme=><a class:list={["tour-image-link",`tour-shot-${theme}`]} href={`${base}product-tour/${screen.id}-${theme}.png`} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size ${screen.choice.toLowerCase()} screenshot`}><img src={`${base}product-tour/${screen.id}-${theme}.png`} width="1120" height="760" loading="lazy" decoding="async" alt={screen.alt} /></a>)}
  <figcaption class="small muted">Sample data in the actual Lore app. Select the image to inspect it at full size.</figcaption>
 </figure>)}
</section>
