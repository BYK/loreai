---
import config from "virtual:starlight/user-config";
import Search from "virtual:starlight/components/Search";
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Logo from "./Logo.astro";
import PrimaryLinks from "./PrimaryLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
const shouldRenderSearch = config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";
---
<div class="header docs-site-header"><Logo theme="auto" size={36} /><div class="docs-primary"><PrimaryLinks /></div>{shouldRenderSearch && <Search />}<div class="docs-controls"><ThemeToggle /><LanguageSelect /></div></div>
<script>import "../scripts/menus.js";</script>
<style>
  .docs-site-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 100%; }
  .docs-site-header site-search { flex:1;min-width:0;max-width:14rem; }
  .docs-site-header .primary-nav ul { gap:.25rem .875rem; }
  .docs-controls { display: flex; align-items: center; gap: .75rem; margin-inline-start: auto; }
  @media (max-width: 50rem) { .docs-primary { display: none; } }
</style>
