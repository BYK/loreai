---
import ChoiceGroup from "./ui/ChoiceGroup.astro";
import ChoiceItem from "./ui/ChoiceItem.astro";
import NavigationIcon from "./NavigationIcon.astro";
const base = import.meta.env.BASE_URL;
const views = [
  { id: "rule", label: "Rule", title: "Keep handlers idempotent", description: "Edit an outdated convention directly in Knowledge.", note: "Review the source and recorded revisions before relying on an entry.", action: "Inspect the rule" },
  { id: "source", label: "Source", title: "Follow the source session", note: "The source session is available; exact-message attribution is not recorded.", action: "Inspect the source" },
  { id: "history", label: "History", title: "See which version is current", note: "Two versions are recorded in this sample.", action: "Inspect the history" },
] as const;
---
<section class="section product-spotlight" id="product" aria-labelledby="product-title">
  <div class="spotlight-heading"><div><p class="eyebrow">Inside the local app</p><h2 id="product-title">Memory you can inspect.</h2></div><a class="text-link icon-link" href={`${base}tour/?view=knowledge#product`}><span class="link-label">Explore the app</span> <span aria-hidden="true">↗</span></a></div>
  <div class="spotlight-workbench">
    <div class="workbench-bar"><span class="workbench-project"><NavigationIcon name="app" />webhook-service <span>/ Knowledge</span></span><ChoiceGroup class="guide-segments spotlight-choices" legend="Explore project memory" hideLegend>{views.map((view,index)=><ChoiceItem name="product-preview" value={view.id} checked={index===0} label={view.label} controls={`preview-${view.id}`} />)}</ChoiceGroup></div>
    <div class="workbench-body">
      <figure class="spotlight-image">{views.map(view=><a class="tour-image-link" data-preview-image={view.id} href={`${base}tour/?view=knowledge&inspect=${view.id}#product`} aria-label="Explore the Lore memory browser">{(["light","dark"] as const).map(theme=><picture class={`tour-shot-${theme}`}><source media="(max-width:640px)" srcset={`${base}product-tour/proof-${view.id}-mobile-${theme}.png`} width={view.id === "rule" ? 390 : view.id === "source" ? 340 : 678} height={view.id === "rule" ? 185 : view.id === "source" ? 205 : 177} /><img src={`${base}product-tour/knowledge-detail-${theme}.png`} width="734" height="858" loading="lazy" decoding="async" alt="Actual Lore app showing a sample saved project rule, its source session and recorded revisions" /></picture>)}</a>)}</figure>
      <div class="spotlight-explanations">{views.map((view,index)=><section data-preview-panel={view.id} id={`preview-${view.id}`} aria-labelledby={`preview-title-${view.id}`}><p class="field-marker">0{index+1} / {view.label}</p><h3 id={`preview-title-${view.id}`}>{view.title}</h3>{view.id === "rule" && <p>{view.description}</p>}{view.id === "source" && <dl class="preview-record"><div><dt>Source session</dt><dd>sample-session</dd></div></dl>}{view.id === "history" && <dl class="preview-record preview-versions"><div><dt>v2</dt><dd>Current</dd></div><div><dt>v1</dt><dd>Superseded</dd></div></dl>}<p class="preview-note">{view.note}</p><a class="text-link icon-link" href={`${base}tour/?view=knowledge&inspect=${view.id}#product`}><span class="link-label">{view.action} in the full tour</span> <span aria-hidden="true">→</span></a></section>)}</div>
    </div>
    <div class="workbench-caption"><span>Actual Lore app · sample webhook project</span>{(["light","dark"] as const).map(theme=><a class={`icon-link tour-shot-${theme}`} href={`${base}product-tour/knowledge-detail-${theme}.png`} target="_blank" rel="noopener noreferrer"><span class="link-label">Open original app capture</span> <span aria-hidden="true">↗</span></a>)}</div>
  </div>
</section>
<script>
import { bindUrlChoice } from "../scripts/url-choice";
bindUrlChoice(".spotlight-choices", "preview", ["rule", "source", "history"]);
</script>
<style>
  :global(.home-page) section.product-spotlight { display:block;padding:1rem 0 1.25rem;border:0;background:transparent; }
  .spotlight-heading { display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:16px; }
  .spotlight-heading .eyebrow { font-size:.75rem;margin-bottom:8px; }
  .spotlight-heading h2 { font-size:clamp(1.5rem,2.6vw,2rem);margin:0; }
  .spotlight-heading > a { font-size:.875rem;gap:10px;flex-shrink:0; }
  .spotlight-workbench { overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-card);background:var(--surface); }
  .workbench-bar { display:flex;align-items:center;justify-content:space-between;gap:16px;padding:10px 16px;border-bottom:1px solid var(--line); }
  .workbench-project { display:inline-flex;align-items:center;gap:8px;font-size:.75rem;white-space:nowrap; }
  .workbench-project > span { color:var(--muted); }
  .workbench-project :global(svg) { color:var(--accent); }
  fieldset.spotlight-choices { padding:0;background:transparent;flex-wrap:nowrap; }
  .spotlight-choices label { flex:1;min-width:0; }
  .spotlight-choices label > span { display:flex;align-items:center;gap:6px;padding:8px 10px; }
  .spotlight-choices small { color:var(--muted);font:.625rem/1 ui-monospace,monospace; }
  .spotlight-choices label:has(:checked) small { color:var(--accent); }
  .workbench-body { display:grid;grid-template-columns:1.7fr 1fr; }
  .spotlight-image { position:relative;min-width:0;height:340px;margin:0;overflow:hidden;background:var(--chrome); }
  .spotlight-image > a { position:absolute;inset:0;display:none;overflow:hidden;border:0;border-radius:0; }
  .spotlight-image > a:focus-visible { outline-offset:-4px; }
  .spotlight-image img { display:block;width:100%;min-width:640px;max-width:none;height:auto;border:0;border-radius:0;transform:translateY(var(--crop-y,0%)); }
  [data-preview-image="source"] { --crop-y:-32%; }
  [data-preview-image="history"] { --crop-y:-57%; }
  .spotlight-explanations { padding:20px;border-inline-start:1px solid var(--line);background:var(--journal-page); }
  .spotlight-explanations > section { display:none; }
  .product-spotlight:has(input[value="rule"]:checked) :is([data-preview-image="rule"],[data-preview-panel="rule"]),
  .product-spotlight:has(input[value="source"]:checked) :is([data-preview-image="source"],[data-preview-panel="source"]),
  .product-spotlight:has(input[value="history"]:checked) :is([data-preview-image="history"],[data-preview-panel="history"]) { display:block; }
  .spotlight-explanations .field-marker { font-size:.75rem;margin-bottom:6px; }
  .spotlight-explanations h3 { font-size:1.125rem;line-height:1.4;letter-spacing:-.02em;margin-bottom:8px; }
  .spotlight-explanations section > p:not(.field-marker) { font-size:.875rem;line-height:1.7; }
  .spotlight-explanations .preview-note { color:var(--muted);font-size:.75rem!important;margin-top:8px; }
  .spotlight-explanations .text-link { gap:8px;font-size:.8125rem;margin-top:8px; }
  .preview-record { display:grid;gap:8px;margin:12px 0; }
  .preview-record div { display:flex;flex-wrap:wrap;gap:4px 12px;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:8px; }
  .preview-record dt { color:var(--muted);font-size:.75rem; }.preview-record dd { font-size:.75rem;margin:0; }
  .preview-versions div:first-child dt { color:var(--accent); }
  .workbench-caption { display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:4px 16px;padding:4px 16px;border-top:1px solid var(--line);font-size:.75rem;color:var(--muted); }
  .workbench-caption a { min-height:44px;align-content:center; }
  @media(max-width:900px) { .workbench-body { grid-template-columns:1.3fr 1fr; }.spotlight-explanations { padding:20px; }.workbench-project > span { display:none; } }
  @media(max-width:640px) { .spotlight-heading { display:block;margin-bottom:8px; }.spotlight-heading > a { margin-top:8px; }.workbench-project { display:none; }.workbench-bar { padding:8px 10px; }.spotlight-choices { width:100%; }.workbench-body { grid-template-columns:1fr; }.spotlight-image { height:220px; }.spotlight-image img { width:100%;min-width:0;max-width:100%;height:auto;transform:none; }.spotlight-image > a { align-content:center; }.spotlight-explanations { border-inline-start:0;border-top:1px solid var(--line);padding:20px; }.workbench-caption { padding:10px 16px 4px; }.workbench-caption > span { font-size:.6875rem; } }
</style>
