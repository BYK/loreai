---
import ChoiceGroup from "./ui/ChoiceGroup.astro";
import ChoiceItem from "./ui/ChoiceItem.astro";
const base = import.meta.env.BASE_URL;
import { WORKFLOW_APPROACHES as choices } from "../lib/workflow-fit";
---
<div class="fit-guide"><ChoiceGroup class="guide-segments" legend="What are you trying to do?">{choices.map((choice,index)=><ChoiceItem name="workflow-fit" value={choice.id} checked={index===0} label={choice.label} icon={choice.icon} controls={`fit-${choice.id}`} />)}</ChoiceGroup>
 {choices.map(choice=><div class="fit-explanation" data-fit-panel={choice.id} id={`fit-${choice.id}`}><h3>{choice.title}</h3><p>{choice.text}</p><a class="text-link icon-link" href={choice.local ? `${base}${choice.href}` : choice.href}><span class="link-label">{choice.action}</span><span aria-hidden="true">→</span></a></div>)}<p class="fit-table-hint">Review your selected approach below, then compare alternatives.</p>
</div>
<script>
import { bindUrlChoice } from "../scripts/url-choice";
bindUrlChoice(".fit-guide", "fit", ["coding", "rules", "application", "framework"]);
</script>
