---
import ChoiceGroup from "./ui/ChoiceGroup.astro";
import ChoiceItem from "./ui/ChoiceItem.astro";
const base = import.meta.env.BASE_URL;
const choices = [
 {id:"coding",icon:"app",label:"Use an existing coding agent",title:"Add memory to your existing agent.",action:"Choose your coding agent",href:`${base}docs/install/`,text:"Check your client’s connection path, then verify a recorded session."},
 {id:"rules",icon:"notes",label:"Keep a few stable rules",title:"A concise instruction file may be enough.",action:"Read the instruction-file guide",href:`${base}docs/team-memory/#reviewing-memory-changes`,text:"Keep the instructions accurate as your project changes."},
 {id:"application",icon:"code",label:"Build an application",title:"Evaluate memory as part of your application.",action:"Explore memory APIs",href:"https://docs.mem0.ai/platform/quickstart",text:"Check SDK/API fit, deployment, data boundaries and retrieval behavior. Compare Mem0 and Supermemory in the table below."},
 {id:"framework",icon:"workflow",label:"Build an agent workflow",title:"Build around the agent you own.",action:"Explore Mastra workflows",href:"https://mastra.ai/docs",text:"Compare memory, tools and workflow orchestration together."},
] as const;
---
<div class="fit-guide"><ChoiceGroup class="guide-segments" legend="What are you trying to do?">{choices.map((choice,index)=><ChoiceItem name="workflow-fit" value={choice.id} checked={index===0} label={choice.label} icon={choice.icon} controls={`fit-${choice.id}`} />)}</ChoiceGroup>
 {choices.map(choice=><div class="fit-explanation" data-fit-panel={choice.id} id={`fit-${choice.id}`}><h3>{choice.title}</h3><p>{choice.text}</p><a class="text-link icon-link" href={choice.href}><span class="link-label">{choice.action}</span><span aria-hidden="true">→</span></a></div>)}<p class="fit-table-hint">Compare the highlighted option below.</p>
</div>
<script>
import { bindUrlChoice } from "../scripts/url-choice";
bindUrlChoice(".fit-guide", "fit", ["coding", "rules", "application", "framework"]);
</script>
