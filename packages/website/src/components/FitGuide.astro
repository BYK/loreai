---
import ChoiceGroup from "./ui/ChoiceGroup.astro";
import ChoiceItem from "./ui/ChoiceItem.astro";
const choices = [
 {id:"coding",label:"Use an existing coding agent",title:"Keep your client. Add reviewable project memory.",text:"Check your client’s connection path, then verify a recorded session."},
 {id:"rules",label:"Keep a few stable rules",title:"A concise instruction file may be enough.",text:"Decide who will keep those instructions accurate as the project changes."},
 {id:"application",label:"Build an application",title:"Evaluate memory as part of your application.",text:"Check SDK/API fit, deployment, data boundaries and retrieval behavior."},
 {id:"framework",label:"Build an agent workflow",title:"Choose the framework around the agent you own.",text:"Evaluate memory alongside the tools and workflows you will maintain."},
] as const;
---
<div class="fit-guide"><ChoiceGroup class="guide-segments" legend="What are you trying to do?">{choices.map((choice,index)=><ChoiceItem name="workflow-fit" value={choice.id} checked={index===0} label={choice.label} controls={`fit-${choice.id}`} />)}</ChoiceGroup>
 {choices.map(choice=><div class="fit-explanation" data-fit-panel={choice.id} id={`fit-${choice.id}`}><h3>{choice.title}</h3><p>{choice.text}</p></div>)}<p class="fit-table-hint">Your selection highlights a row below. The complete comparison stays available.</p>
</div>
<script>
import { bindUrlChoice } from "../scripts/url-choice";
bindUrlChoice(".fit-guide", "fit", ["coding", "rules", "application", "framework"]);
</script>
