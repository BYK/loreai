---
import NavigationIcon from "./NavigationIcon.astro";
import ChoiceGroup from "./ui/ChoiceGroup.astro";
import ChoiceItem from "./ui/ChoiceItem.astro";
const base = import.meta.env.BASE_URL;
const cases = [
 {id:"session",icon:"chat",step:"Look for a fresh message",label:"Missing session",observe:"The agent responds, but the conversation is not in Lore’s Sessions list.",check:"Open the printed Dashboard URL, select the project that launched your agent, and clear the session search filter. Send a fresh message through your client’s Lore connection path.",result:"A newly recorded message is the connection check. Knowledge does not have to appear yet.",href:"docs/first-session/#verify",action:"Verify the connection",reference:"missing-session"},
 {id:"knowledge",icon:"bookmark",step:"Check background processing",label:"No knowledge yet",observe:"Sessions contains your conversation, but Knowledge or .lore.md has no new entry.",check:"Check Sessions first. Distillation and curation happen in the background; one short message is not a reliable extraction test. Inspect processing and provider errors before restarting or importing again.",result:"Recording and knowledge extraction are separate milestones. An absent rule alone does not mean the connection failed.",href:"docs/memory/",action:"Understand the memory stages",reference:"knowledge-has-not-appeared"},
 {id:"gateway",icon:"connect",step:"Check the running gateway",label:"Gateway unavailable",observe:"The Dashboard cannot be reached, or a separately launched client cannot connect.",check:"Keep Lore running and use its printed Dashboard URL. Run lore doctor from the affected project and inspect gateway/process findings; optional checks do not all need to be green.",result:"Use the printed Dashboard URL rather than assuming a fixed port. Follow the relevant finding before restarting.",href:"docs/install/",action:"Check your connection path",reference:"gateway-unavailable"},
] as const;
---
<section class="diagnostic-guide" id="diagnostic" aria-label="Find your next troubleshooting check">
 <ChoiceGroup class="guide-segments" legend="What can you observe?">{cases.map((item,index)=><ChoiceItem name="diagnostic-issue" value={item.id} checked={index===0} label={item.label} icon={item.icon} controls={`diagnostic-${item.id}`} />)}</ChoiceGroup>
 {cases.map(item=><div class="diagnostic-panel" data-issue-panel={item.id} id={`diagnostic-${item.id}`}><ol class="diagnostic-checks"><li><span><NavigationIcon name="search" /> What you see</span><p>{item.observe}</p></li><li><span><NavigationIcon name="settings" /> {item.step}</span><p>{item.check}</p></li><li><span><NavigationIcon name="check" /> What to expect</span><p>{item.result}</p></li></ol><div class="diagnostic-next"><a href={`${base}${item.href}`} class="icon-link"><span class="link-label">{item.action}</span> <span aria-hidden="true">→</span></a><a href={`${base}docs/troubleshooting/#${item.reference}`}>Full reference</a></div></div>)}
</section>
<script>
import { bindUrlChoice } from "../scripts/url-choice";
bindUrlChoice(".diagnostic-guide", "issue", ["session", "knowledge", "gateway"]);
</script>
