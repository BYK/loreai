---
import EditLink from "virtual:starlight/components/EditLink";
import LastUpdated from "virtual:starlight/components/LastUpdated";
import PublicFooter from "./PublicFooter.astro";
import DocsNextAction from "./DocsNextAction.astro";
const { entry, headings, pagination } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, "");
// An authored ending already supplies navigation. Do not append a second journey
// through Starlight's sidebar order or the former generic four-link help row.
const authoredNext = headings.some(heading => heading.slug === "next-steps");
const primary = path === "docs" ? {title:"Install and connect Lore",href:"/docs/install/",text:"Choose your machine and client, then verify a recorded session."}
  : path === "docs/first-session" ? {title:"Use Lore day to day",href:"/docs/using-lore/",text:"Find an earlier decision, review its source, and correct project knowledge."}
  : path === "docs/using-lore" ? {title:"Share reviewed knowledge through Git",href:"/docs/team-memory/",text:"Carry useful project rules to a teammate after reviewing the .lore.md diff."}
  : pagination.next ? {title:pagination.next.label,href:pagination.next.href}
  : {title:"Choose another task",href:"/docs/"};
const related = path === "docs" ? [{title:"Using an existing installation",href:"/docs/first-session/"},{title:"Troubleshooting",href:"/docs/troubleshooting/"}]
  : path === "docs/first-session" ? [{title:"Try the sample workflow",href:"/docs/example/"},{title:"Missing session",href:"/docs/troubleshooting/#missing-session"}]
  : path === "docs/using-lore" ? [{title:"Memory and context",href:"/docs/memory/"},{title:"Data and costs",href:"/docs/data-and-costs/"}]
  : [{title:"Choose a task",href:"/docs/"},{title:"Troubleshooting",href:"/docs/troubleshooting/"}];
---
{entry.id === "404" ? <PublicFooter /> : <footer class="docs-footer">
  {!authoredNext && path !== "docs/install" && <DocsNextAction {...primary} related={related} />}
  <div class="docs-meta"><EditLink /><LastUpdated /></div>
</footer>}
<style>
.docs-meta { display:flex;flex-wrap:wrap;justify-content:space-between;gap:.75rem 2rem;margin-top:2rem;font-size:var(--sl-text-sm);color:var(--sl-color-gray-3); }.docs-meta > :global(p:only-child) { margin-inline-start:auto; }
</style>
