---
import NavigationIcon from "./NavigationIcon.astro";
import Footer from '@astrojs/starlight/components/Footer.astro';
const base=import.meta.env.BASE_URL;
const integration= /\/docs\/guides\/with-(claude-code|codex|opencode|pi|hermes)\/$/.test(Astro.url.pathname);
const actions=[{label:"Get started",href:"install/",icon:"connect"},{label:"Using Lore",href:"using-lore/",icon:"compass"},{label:"Troubleshooting",href:"troubleshooting/",icon:"help"},{label:"Data & costs",href:"data-and-costs/",icon:"activity"}] as const;
---
<Footer {...Astro.props} />
{!integration && <nav class="docs-help-links" aria-label="Documentation help">{actions.map(action=><a class="icon-link" href={`${base}docs/${action.href}`}><NavigationIcon name={action.icon} /><span class="link-label">{action.label}</span></a>)}</nav>}
<style>.docs-help-links { display:flex;flex-wrap:wrap;gap:.5rem 1.25rem;border-top:1px solid var(--line);padding-top:1rem;margin-top:1rem; }.docs-help-links a { display:inline-flex;align-items:center;gap:8px;min-height:44px;font-size:.8125rem;color:var(--accent); }</style>
