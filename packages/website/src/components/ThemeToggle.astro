---
const choices = [
  { value: "auto", label: "System", detail: "Follow your device" },
  { value: "light", label: "Light", detail: "Always light" },
  { value: "dark", label: "Dark", detail: "Always dark" },
];
---
<details class="theme-toggle" data-menu>
  <summary aria-label="Theme settings"><span aria-hidden="true">◐</span><span data-theme-current>System</span><span aria-hidden="true">⌄</span></summary>
  <div class="theme-options" role="group" aria-label="Colour theme">
    {choices.map(({ value, label, detail }) => <button type="button" data-theme-choice={value} aria-label={`${label} theme`} aria-pressed="false"><span>{label}</span><small>{detail}</small></button>)}
  </div>
</details>
