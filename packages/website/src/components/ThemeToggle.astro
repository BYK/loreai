---
const choices = [
  { value: "light", label: "Light", detail: "Light theme", path: "M12 3v1m0 16v1M3 12h1m16 0h1M5.64 5.64l.7.7m11.32 11.32.7.7M5.64 18.36l.7-.7M17.66 6.34l.7-.7", circle: true },
  { value: "auto", label: "System", detail: "System theme — follow your device", path: "M8 21h8m-4-4v4", monitor: true },
  { value: "dark", label: "Dark", detail: "Dark theme", path: "M20.9 13.1A9 9 0 0 1 10.9 3.1 9 9 0 1 0 20.9 13.1Z" },
];
---
<div class="theme-toggle" role="group" aria-label="Colour theme">
  {choices.map(({ value, label, detail, path, circle, monitor }) => <button type="button" data-theme-choice={value} aria-label={`${label} theme`} aria-pressed="false" title={detail}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={path} />{circle && <circle cx="12" cy="12" r="4" />}{monitor && <rect x="3" y="3" width="18" height="14" rx="2" />}</svg>
  </button>)}
</div>
