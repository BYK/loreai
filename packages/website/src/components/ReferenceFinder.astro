---
import NavigationIcon from "./NavigationIcon.astro";
import { buildReferenceDirectory } from "../lib/reference-directory";
import { COMMON_SETTING_EXAMPLES } from "../lib/reference-examples";
import AccordionItem from "./ui/AccordionItem.astro";
import "../styles/reference-assistance.css";
const route = Astro.locals.starlightRoute;
const environment = Astro.url.pathname.endsWith("/docs/environment/");
const { categories,settings } = buildReferenceDirectory(route.entry.body ?? "",route.headings,environment ? "environment" : "configuration");
const suggestions = environment ? ["LORE_IDLE_TIMEOUT", "LORE_WORKER_MODEL", "LORE_LISTEN_PORT"] : ["curator", "cache", "search"];
const base = import.meta.env.BASE_URL;
---
<section class="reference-finder" aria-label="Setting directory" data-pagefind-ignore>
  <div class="reference-search" data-finder-search hidden><label for="setting-query"><span class="reference-label"><NavigationIcon name="search" />Find a setting</span></label><div class="reference-search-control"><input id="setting-query" type="search" name="setting" maxlength="160" autocomplete="off" spellcheck="false" placeholder="Search names or categories…" aria-controls="setting-results" /><button type="button" class="ui-icon-button" data-finder-clear hidden aria-label="Clear search" title="Clear search"><NavigationIcon name="close" /></button></div></div>
  <p class="reference-hint">Jump directly to a setting, its default and full explanation. The complete reference stays below.</p>
  <p role="status" data-finder-status></p>
  <ul class="reference-results" id="setting-results" data-finder-results hidden>{settings.map(entry=><li data-search={`${entry.label} ${entry.group} ${entry.description}`} hidden><a href={`#${entry.slug}`}>{entry.label}</a>{(entry.type || entry.defaultValue) && <p class="reference-result-meta">{entry.type && <span>{entry.type}</span>}{entry.defaultValue && <span>Default: {entry.defaultValue}</span>}</p>}{entry.description && <p class="reference-description">{entry.description}</p>}{entry.group && entry.group !== entry.label && <small>In {entry.group}</small>}{entry.kind === "setting" && <div class="reference-actions" data-reference-copy data-copy-value={entry.label} data-copy-slug={entry.slug} hidden><button type="button" class="reference-copy-button" data-copy-kind="path">Copy setting path</button><button type="button" class="reference-copy-button" data-copy-kind="link">Copy setting link</button><span role="status"></span><textarea class="reference-copy-fallback" readonly hidden aria-label="Value to copy manually"></textarea></div>}</li>)}</ul>
  <button type="button" class="button button-secondary reference-more" data-finder-more hidden></button>
  <div class="reference-recovery" data-finder-recovery hidden><p>Try a shorter setting name or browse a category.</p><div class="reference-suggestions">{suggestions.map(query=><button type="button" class="reference-copy-button" data-finder-suggestion={query} aria-label={`Find ${query} settings`}>{query}</button>)}<button type="button" class="reference-copy-button" data-finder-reset>Browse all categories</button></div><p><a href={`${base}docs/${environment ? "configuration" : "environment"}/`}>Look in {environment ? "configuration fields" : "environment variables"}</a> or <a href={`${base}docs/troubleshooting/`}>troubleshoot a setup problem</a>.</p></div>
  <AccordionItem class="reference-directory" title="Browse setting categories" meta={`${categories.length} categories`}><ul class="reference-directory-list">{categories.map(entry=><li><a href={`#${entry.slug}`}>{entry.label}</a>{entry.group && <small>{entry.group}</small>}</li>)}</ul></AccordionItem>
  {!environment && <div role="group" aria-label="Common setting examples" class="reference-examples"><AccordionItem title="Common setting examples" meta="3 small overrides"><p>Merge one example into your project’s <code>.lore.json</code>, restart Lore, then verify the effect. Existing settings and environment overrides still apply. Hosted gateways do not read project configuration.</p>{COMMON_SETTING_EXAMPLES.map(example=><section data-setting-example><h3>{example.title}</h3><p>{example.description} <a href={`#setting-${example.path}`}>Read {example.path}</a>.</p><pre><code>{JSON.stringify(example.value,null,2)}</code></pre><div class="reference-actions" data-reference-copy data-copy-value={JSON.stringify(example.value,null,2)} hidden><button type="button" class="reference-copy-button" data-copy-kind="example">Copy example</button><span role="status"></span><textarea class="reference-copy-fallback" readonly hidden aria-label="Value to copy manually"></textarea></div></section>)}</AccordionItem></div>}
</section>
<script>import "../scripts/reference-finder";</script>
