---
import NavigationIcon from "./NavigationIcon.astro";
import MobileThemePreferences from "./MobileThemePreferences.astro";
import PrimaryLinks from "./PrimaryLinks.astro";
---
<details class="nav-mobile" data-menu>
  <summary class="nav-burger" aria-label="Toggle navigation menu"><span data-menu-icon="open" aria-hidden="true"><NavigationIcon name="menu" /></span><span data-menu-icon="close" aria-hidden="true"><NavigationIcon name="close" /></span><span class="visually-hidden">Navigation</span></summary>
  <div class="nav-mobile-panel">
    <MobileThemePreferences />
    <PrimaryLinks mobile />
  </div>
</details>
