---
import "../styles/blog.css";
import ThemeProvider from "../components/ThemeProvider.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Logo from "../components/Logo.astro";
import SocialMeta from "../components/SocialMeta.astro";

const {
  title = "Lore Blog",
  description = "Product notes, engineering updates, and memory architecture deep dives from Lore.",
  // AT-URI of this post's standard.site document record, when it is an
  // individual post. Omitted on the blog index. See src/lib/standard-site.ts.
  documentUri,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname;
const path = rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath.replace(/^\//, "");
const ogType = path === "blog/" ? "website" : "article";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ThemeProvider />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Lore</title>
    <meta name="description" content={description} />
    <SocialMeta
      title={`${title} | Lore`}
      description={description}
      path={path}
      type={ogType}
    />
    {documentUri && <link rel="site.standard.document" href={documentUri} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}theme.css`} />
  </head>
  <body class="blog-body">
    <header class="blog-nav">
      <Logo theme="auto" size={40} />
      <nav aria-label="Primary navigation">
        <a href={`${import.meta.env.BASE_URL}docs/`}>Docs</a>
        <a href={`${import.meta.env.BASE_URL}blog/`}>Blog</a>
        <a href={`${import.meta.env.BASE_URL}different/`}>Why Lore</a>
        <a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a>
        <a href="https://github.com/byk/loreai" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
      <ThemeToggle />
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="foot-bottom">
        <small>&copy; {new Date().getFullYear()} Lore.AI</small>
      </div>
    </footer>
  </body>
</html>
