---
import "../styles/blog.css";
import PublicLayout from "./PublicLayout.astro";
const { title = "Blog", description = "Product notes, engineering updates, and memory architecture from Lore.", documentUri } = Astro.props;
---
<PublicLayout title={`${title} | Lore`} description={description} bodyClass="blog-body" documentUri={documentUri}><slot /></PublicLayout>
