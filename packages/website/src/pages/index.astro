---
import PublicLayout from "../layouts/PublicLayout.astro";
import KnowledgeFile from "../components/KnowledgeFile.astro";
import QuestJournal from "../components/QuestJournal.astro";
import JournalArt from "../components/JournalArt.astro";
const base = import.meta.env.BASE_URL;
---
<PublicLayout title="Lore.AI — Project memory for coding agents" description="Keep project decisions available across coding sessions. Lore manages context and curates reviewable knowledge for the coding agent you already use." bodyClass="home-page">
  <section class="home-hero section" id="problem">
    <div class="hero-copy"><div class="hero-overview"><div class="hero-heading"><p class="eyebrow">Memory for coding agents</p><h1>Keep project decisions <em>across coding sessions.</em></h1></div><div class="hero-details"><p class="hero-desc">Connect Lore to the coding agent you already use. Keep searchable conversations and reviewable project rules, so you can pick up where you left off.</p>
      <div class="hero-actions"><a class="button button-primary" href={`${base}docs/install/`}>Install Lore <span aria-hidden="true">→</span></a><a class="text-link" href="#product">See the app ↓</a></div>
      <p class="compatibility">Works with Claude Code, Codex, OpenCode, Pi, and Hermes.</p>
    </div></div><KnowledgeFile /></div>
  </section>
  <section class="section product-spotlight" id="product" aria-labelledby="product-title">
    <div class="spotlight-copy"><p class="eyebrow">Inside Lore</p><h2 id="product-title">See and correct what Lore keeps.</h2><p>Inspect the rule, the session behind it, and its earlier revisions in the local memory browser.</p><a class="text-link" href={`${base}tour/?view=knowledge#product`}>Explore the app <span aria-hidden="true">→</span></a></div>
    <figure class="spotlight-image">
      {(["light", "dark"] as const).map(theme => <a class:list={["tour-image-link", `tour-shot-${theme}`]} href={`${base}tour/?view=knowledge#product`} aria-label="Explore the Lore memory browser"><picture><source media="(max-width: 600px)" srcset={`${base}product-tour/knowledge-mobile-${theme}.png`} width="390" height="700" /><img src={`${base}product-tour/knowledge-${theme}.png`} width="1120" height="760" loading="lazy" decoding="async" alt="Lore’s Knowledge view with a project rule and its source history" /></picture></a>)}
      <figcaption class="small muted">The local Lore app, shown with fictional project data. {(["light", "dark"] as const).map(theme => <a class:list={["text-link", `tour-shot-${theme}`]} href={`${base}product-tour/knowledge-${theme}.png`} target="_blank" rel="noopener noreferrer">Open full-size screenshot ↗</a>)}</figcaption>
    </figure>
  </section>
  <section class="section home-journal"><QuestJournal /></section>
  <section class="section home-workflow" id="how" aria-labelledby="workflow-title"><span id="unified" class="fragment-anchor" aria-hidden="true"></span><span id="everyday" class="fragment-anchor" aria-hidden="true"></span>
    <div class="section-heading"><p class="eyebrow">In your everyday work</p><h2 id="workflow-title">Less explaining the same things again.</h2></div>
    <nav class="workflow-links" aria-label="Use your project memory">
      <a href={`${base}docs/using-lore/#find-an-earlier-decision`}><JournalArt name="decision" size={44} /><span><strong>Find an earlier decision</strong><small>Search recorded work instead of reconstructing it.</small></span><span aria-hidden="true">↗</span></a>
      <a href={`${base}docs/using-lore/#review-knowledge`}><JournalArt name="pattern" size={44} /><span><strong>Correct a project rule</strong><small>Review its source, then update what the agent keeps.</small></span><span aria-hidden="true">↗</span></a>
      <a href={`${base}docs/team-memory/`}><JournalArt name="satchel" size={44} /><span><strong>Share reviewed knowledge</strong><small>Carry project conventions through a Git diff.</small></span><span aria-hidden="true">↗</span></a>
    </nav>
    <p class="home-availability" id="features"><span id="local-first" class="fragment-anchor" aria-hidden="true"></span><strong>Available now:</strong> local session memory, reviewable knowledge, and sharing through Git.</p>
  </section>
  <section class="section" id="questions"><div class="section-heading"><p class="eyebrow">Before you install</p><h2>A few practical questions.</h2></div><div class="faq">
    <details><summary>Do I need a different coding agent?</summary><p>No. Lore supports existing clients including Claude Code, Codex, OpenCode, Pi, and Hermes. Follow the guide for your client; desktop apps and terminal launchers have different setup paths. <a href={`${base}docs/install/`}>Choose your setup</a>.</p></details>
    <details><summary>Where does my data go?</summary><p>Memory is stored locally in SQLite and Markdown. Agent requests and Lore’s background LLM work use your configured providers. Production builds send privacy-filtered operational telemetry, which you can disable. <a href={`${base}docs/install/#operational-telemetry`}>Read the telemetry and storage details</a>.</p></details>
    <details><summary>Will a knowledge file appear after one message?</summary><p>Not necessarily. Distillation and curation run in the background and depend on available conversation and configuration. Check recorded sessions in the local browser first, then review any knowledge Lore extracts. <a href={`${base}docs/troubleshooting/?issue=knowledge#diagnostic`}>Follow the knowledge checklist</a>.</p></details>
    <details><summary>Does local Lore include live team sync?</summary><p>Git-based knowledge sharing is available today. Folk Lore’s hosted team experience is in early access; you can join its interest list on the Why Lore page. It does not enable sync.</p></details>
    <p class="faq-help">Something missing? <a href={`${base}docs/troubleshooting/?issue=session#diagnostic`}>Check a missing session</a> or <a href={`${base}docs/troubleshooting/?issue=gateway#diagnostic`}>check your gateway</a>.</p>
  </div></section>
  <section class="section home-start" id="get-started">
    <div><h2>Bring your next session along.</h2><p>Choose your agent and connect your first project.</p></div><a class="button button-primary" href={`${base}docs/install/`}>Get started <span aria-hidden="true">→</span></a>
    <div class="home-resources"><p id="evidence"><span id="voices" class="fragment-anchor" aria-hidden="true"></span><a href={`${base}docs/benchmark/`}>Read the evaluation and its limitations</a></p><p id="waitlist"><a href={`${base}different/#waitlist`}>Early access to Folk Lore for teams</a></p></div>
  </section>
</PublicLayout>
