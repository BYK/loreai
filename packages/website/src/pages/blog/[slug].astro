---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { documentUri } from "../../lib/standard-site";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  documentUri={documentUri(post.id)}
>
  <article class="blog-post">
    <a class="blog-back" href={`${import.meta.env.BASE_URL}blog/`}>Back to blog</a>
    <header>
      <p class="eyebrow">{post.data.kind} · {post.data.author}</p>
      <h1>{post.data.title}</h1>
      {post.data.subtitle && <p class="blog-subtitle">{post.data.subtitle}</p>}
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("en", { month: "long", day: "numeric", year: "numeric" })}
      </time>
      <p>{post.data.description}</p>
    </header>
    {post.data.takeaway && <aside class="article-takeaway" aria-label="Practical takeaway"><strong>In practice</strong><p>{post.data.takeaway}</p><a href={`${import.meta.env.BASE_URL}docs/team-memory/`}>Current availability: local Lore and Git sharing; Folk Lore early access →</a></aside>}
    <div class="blog-prose">
      <Content />
    </div>
    <nav class="article-next" aria-label="Put this into practice"><h2>Put this into practice</h2><a href={`${import.meta.env.BASE_URL}${(post.data.nextStep?.href ?? "/docs/first-session/").replace(/^\//, "")}`}>{post.data.nextStep?.label ?? "Connect and verify your first Lore session"} →</a><a href={`${import.meta.env.BASE_URL}docs/troubleshooting/`}>Get help with your setup</a></nav>
  </article>
</BlogLayout>
