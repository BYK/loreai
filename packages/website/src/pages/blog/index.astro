---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import JournalArt from "../../components/JournalArt.astro";
const posts = (await getCollection("blog")).filter(post => !post.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured=posts.find(post=>post.id === "how-lore-remembers-and-forgets");
---
<BlogLayout title="Blog" description="Product notes, practical guides, and engineering from Lore.">
  <section class="blog-hero field-heading"><div><p class="eyebrow field-marker">From the Lore team / Field notes</p><h1>Blog</h1><p>Product notes, practical guides, and engineering.</p><a class="text-link" href={`${import.meta.env.BASE_URL}rss.xml`}>Subscribe with RSS →</a></div><JournalArt name="satchel" size={96} eager /></section>
  {featured && <aside class="featured-note"><p class="field-marker">Start here</p><h2><a href={`${import.meta.env.BASE_URL}blog/${featured.id}/`}>{featured.data.title}</a></h2><p>Understand what Lore records, what it keeps as knowledge, and what reaches your next request.</p><a class="text-link" href={`${import.meta.env.BASE_URL}blog/${featured.id}/`}>Read how memory works →</a></aside>}
  <section class="blog-list" aria-label="Blog posts">{posts.filter(post=>post.id!==featured?.id).map(post => <article class="post-row"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</time><div><p class="post-kind">{post.data.kind}</p><h2><a href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p>{post.data.tags.length > 0 && <p class="post-tags"><span class="visually-hidden">Topics: </span>{post.data.tags.join(" · ")}</p>}</div></article>)}</section>
</BlogLayout>
