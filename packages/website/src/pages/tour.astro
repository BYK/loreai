---
import StartCard from "../components/StartCard.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import ProductTour from "../components/ProductTour.astro";
const base = import.meta.env.BASE_URL;
---
<PublicLayout title="View app tour — Lore.AI" description="See how to find recorded sessions, review project knowledge, and inspect model activity in Lore’s local memory browser.">
  <div class="section tour-intro"><a class="text-link icon-link" href={base}><span aria-hidden="true">←</span> <span class="link-label">Back to Lore</span></a><h1 id="tour-title">See what your agent remembers.</h1><p>Explore Sessions, Knowledge and model activity in real app captures. The webhook project and its data are fictional.</p></div>
  <ProductTour />
  <StartCard />
</PublicLayout>
